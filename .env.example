# Copy to .env and populate with real values. Never commit a populated .env.

APP_NAME=financial-audit-rag-backend
APP_ENV=production
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
ALLOWED_CORS_ORIGINS=["https://your-frontend.example.com"]

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<secret>
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=<your-gpt-deployment-name>
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_EMBEDDING_DIMENSIONS=3072

# --- Azure AI Search ---
AZURE_SEARCH_ENDPOINT=https://<your-service>.search.windows.net
AZURE_SEARCH_API_KEY=<secret>
AZURE_SEARCH_INDEX_NAME=<your-index-name>
AZURE_SEARCH_VECTOR_FIELD=content_vector
AZURE_SEARCH_CONTENT_FIELD=content
AZURE_SEARCH_SEMANTIC_CONFIG=default-semantic-config
AZURE_SEARCH_TOP_K=8

# --- Database ---
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/<database>
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# --- MLflow ---
MLFLOW_TRACKING_URI=http://mlflow-server:5000
MLFLOW_EXPERIMENT_NAME=financial-audit-rag

# --- RAG / chunking ---
CHUNK_TOKEN_SIZE=512
CHUNK_TOKEN_OVERLAP=64
MAX_CONTEXT_TOKENS=8000
MAX_COMPLETION_TOKENS=1200
TIKTOKEN_ENCODING=cl100k_base
